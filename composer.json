{
	"name": "atlas-relics/atlas-relics-wordpress",
	"description": "Coding-standards tooling for the Atlas Relics WordPress ecosystem.",
	"type": "project",
	"license": "proprietary",
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
